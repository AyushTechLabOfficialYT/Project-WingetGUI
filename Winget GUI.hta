<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="x-ua-compatible" content="IE=edge">
    <title>Winget GUI</title>
    <HTA:APPLICATION ID="WingetApp" BORDER="thin" SCROLL="yes" SINGLEINSTANCE="yes" WINDOWSTATE="maximize">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; background-color: #f4f6f9; color: #333; font-size: 18px; overflow-x: hidden; transition: background 0.3s, color 0.3s; }
        body.dark-mode { background-color: #1e1e1e; color: #f4f4f4; }
        
        .header { background-color: #3b5998; color: white; padding: 20px 30px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; box-shadow: 0 4px 6px rgba(0,0,0,0.2); }
        .menu-btn { font-size: 32px; cursor: pointer; user-select: none; transition: transform 0.2s; }
        .menu-btn:hover { transform: scale(1.1); }
        .title { font-size: 32px; font-weight: bold; margin: 0; flex-grow: 1; text-align: center; letter-spacing: 1px; }
        .btn-update-all { background-color: #28a745; color: white; border: 3px solid #1e7e34; padding: 12px 25px; border-radius: 30px; font-weight: bold; cursor: pointer; font-size: 20px; transition: background 0.2s; }
        .btn-update-all:hover { background-color: #218838; }
        
        .container { padding: 30px 2%; width: 96%; margin: 0 auto; }
        .app-row { display: flex; align-items: center; background: white; margin-bottom: 15px; padding: 15px 20px; border-radius: 12px; box-shadow: 0 3px 6px rgba(0,0,0,0.15); transition: transform 0.2s; }
        .app-row:hover { transform: translateY(-2px); box-shadow: 0 5px 10px rgba(0,0,0,0.2); }
        body.dark-mode .app-row { background: #2d2d2d; box-shadow: 0 3px 6px rgba(0,0,0,0.5); }
        
        .logo-box { width: 50px; height: 50px; background-color: #28a745; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; border: 3px solid #0056b3; margin-right: 20px; font-size: 24px; }
        .col-name { flex: 3; font-size: 22px; font-weight: bold; }
        .col-ver { flex: 1.5; text-align: center; color: #555; font-size: 18px; }
        body.dark-mode .col-ver { color: #bbb; }
        .col-action { flex: 1.5; text-align: right; white-space: nowrap; }
        
        .btn-update { background-color: #28a745; color: white; border: 3px solid #000; padding: 12px 20px; border-radius: 10px; cursor: pointer; font-weight: bold; width: 150px; font-size: 18px; transition: opacity 0.2s; }
        .btn-update:hover { opacity: 0.8; }
        
        .btn-progress { color: white; border: 2px solid #0056b3; padding: 12px 10px; border-radius: 10px; width: 120px; display: inline-block; text-align: center; font-weight: bold; font-size: 18px; background: linear-gradient(90deg, #00a2ed 25%, #0056b3 50%, #00a2ed 75%); background-size: 200% 100%; animation: loadingBar 1.5s infinite linear; vertical-align: middle;}
        @keyframes loadingBar { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }
        
        .btn-cancel { background-color: red; color: white; border: 2px solid darkred; padding: 12px 15px; border-radius: 10px; cursor: pointer; font-weight: bold; font-size: 18px; display: inline-block; margin-left: 5px; vertical-align: middle; }
        .btn-cancel:hover { background-color: darkred; }

        .btn-updated { background-color: #28a745; color: white; border: 2px solid white; padding: 12px 20px; border-radius: 10px; width: 150px; display: inline-block; text-align: center; font-weight: bold; font-size: 18px; box-shadow: 0 0 10px #28a745; animation: glow 2s infinite; }
        @keyframes glow { 0% { box-shadow: 0 0 5px #28a745; } 50% { box-shadow: 0 0 20px #28a745; } 100% { box-shadow: 0 0 5px #28a745; } }
        
        .btn-prompt { background-color: white; color: #ffc107; border: 3px solid #000; padding: 12px 20px; border-radius: 10px; width: 150px; display: inline-block; text-align: center; font-weight: bold; font-size: 18px; }
        .text-error { color: red; font-weight: bold; width: 150px; display: inline-block; text-align: center; font-size: 18px; cursor: pointer; border: 2px dashed red; padding: 10px; border-radius: 8px; transition: background 0.2s; background: rgba(255,0,0,0.05); }
        .text-error:hover { background: rgba(255,0,0,0.2); }
        
        .overlay { visibility: hidden; opacity: 0; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 200; display: flex; align-items: center; justify-content: center; transition: opacity 0.3s ease, visibility 0.3s ease; }
        .overlay.show { visibility: visible; opacity: 1; }
        .dialog { background: white; width: 600px; border: 3px solid #000; display: flex; flex-direction: column; position: relative; border-radius: 8px; transform: scale(0.8); transition: transform 0.3s ease; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
        .overlay.show .dialog { transform: scale(1); }
        body.dark-mode .dialog { background: #333; color: white; border-color: #555; }
        
        .dialog-header { background-color: #3b5998; color: white; padding: 15px; font-weight: bold; text-align: center; font-size: 26px; border-top-left-radius: 5px; border-top-right-radius: 5px; }
        .dialog-close { position: absolute; right: 15px; top: 15px; background: red; color: white; border: 2px solid black; cursor: pointer; font-weight: bold; width: 30px; height: 30px; text-align: center; line-height: 26px; font-size: 20px; border-radius: 4px; }
        .dialog-body { padding: 30px; text-align: center; font-size: 20px; }
        .error-text { color: red; font-weight: bold; font-size: 18px; margin-top: 15px; text-align: left; overflow-y: auto; max-height: 250px; background: rgba(255,0,0,0.05); padding: 10px; border: 1px solid red; }
        
        .side-menu { position: fixed; top: 0; left: -400px; width: 350px; height: 100%; background: #fff; box-shadow: 5px 0 15px rgba(0,0,0,0.3); z-index: 300; padding: 25px; overflow-y: auto; transition: left 0.3s ease; }
        .side-menu.open { left: 0; }
        body.dark-mode .side-menu { background: #222; }
        .menu-close { text-align: right; cursor: pointer; color: red; font-weight: bold; font-size: 28px; }
        .menu-item { margin: 25px 0; font-size: 20px; display: flex; justify-content: space-between; align-items: center; }
        .btn-refresh { background: #00a2ed; color: white; font-weight: bold; padding: 15px; width: 100%; border: none; border-radius: 8px; cursor: pointer; font-size: 20px; margin-top: 10px; border: 2px solid #0056b3; margin-bottom: 20px;}
        
        /* Animated Toggle Switch */
        .toggle-switch { position: relative; display: inline-block; width: 50px; height: 26px; }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .3s; border-radius: 26px; }
        .slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 4px; bottom: 4px; background-color: white; transition: .3s; border-radius: 50%; }
        input:checked + .slider { background-color: #28a745; }
        input:checked + .slider:before { transform: translateX(24px); }

        #loadingText { text-align: center; font-size: 24px; margin-top: 60px; font-weight: bold; }
    </style>
    <script type="text/javascript">
        var shell = new ActiveXObject("WScript.Shell");
        var allApps = [];
        var appList = [];
        var bannedApps = ["Microsoft.Edge"];
        var activeUpdates = 0;
        var updateStartTime = null;
        
        function checkInternet() { return navigator.onLine; }

        function initApp() {
            if (!checkInternet()) {
                showDialog('noInternetModal');
                document.getElementById('loadingText').innerText = "Offline.";
                return;
            }
            loadUpdates();
        }

        function loadUpdates() {
            document.getElementById('loadingText').style.display = "block";
            document.getElementById('appContainer').innerHTML = "";
            
            var tmpFile = shell.ExpandEnvironmentStrings("%TEMP%") + "\\winget_out.txt";
            var cmd = 'cmd.exe /c winget upgrade > "' + tmpFile + '" 2>&1';
            shell.Run(cmd, 0, true);
            
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            if (fso.FileExists(tmpFile)) {
                var file = fso.OpenTextFile(tmpFile, 1);
                var output = "";
                if (!file.AtEndOfStream) { output = file.ReadAll(); }
                file.Close();
                parseWingetOutput(output);
            } else {
                document.getElementById('loadingText').innerText = "Failed to read winget output.";
            }
        }

        function parseWingetOutput(text) {
            var lines = text.split('\n');
            var startParsing = false;
            allApps = [];
            
            for (var i = 0; i < lines.length; i++) {
                var line = lines[i].replace(/^\s+|\s+$/g, "");
                if (line.indexOf("---") === 0) { startParsing = true; continue; }
                
                if (startParsing && line.length > 10) {
                    var cols = line.split(/\s{2,}/); 
                    if (cols.length >= 4) {
                        var id = cols[1];
                        var name = cols[0];
                        var cur = cols[2];
                        var newv = cols[3];
                        
                        if (cols.length > 4 && cols[3] === '<') { newv = cols[4]; }
                        newv = newv.replace(/winget/gi, "").replace(/</g, "").replace(/^\s+|\s+$/g, "");
                        
                        allApps.push({ id: id, name: name, cur: cur, newv: newv });
                    }
                }
            }
            renderApps();
            renderBanList();
        }

        function renderApps() {
            appList = [];
            for (var i = 0; i < allApps.length; i++) {
                var isBanned = false;
                for (var b = 0; b < bannedApps.length; b++) {
                    if (allApps[i].id === bannedApps[b]) isBanned = true;
                }
                if (!isBanned) appList.push(allApps[i]);
            }

            document.getElementById('loadingText').style.display = "none";
            var container = document.getElementById('appContainer');
            container.innerHTML = "";
            
            if (appList.length === 0) {
                container.innerHTML = "<h2 style='text-align:center;'>All apps are up to date!</h2>";
                return;
            }

            var headerHtml = "<div style='display:flex; padding:0 20px; font-weight:bold; margin-bottom:10px; font-size:22px;'>";
            headerHtml += "<div style='width:70px;'></div><div style='flex:3;'>Name</div>";
            headerHtml += "<div style='flex:1.5; text-align:center;'>Current Version</div><div style='flex:1.5; text-align:center;'>Latest version</div><div style='flex:1.5;'></div></div>";
            container.innerHTML += headerHtml;

            for (var j = 0; j < appList.length; j++) {
                var app = appList[j];
                var html = "<div class='app-row'>";
                html += "<div class='logo-box'>" + app.name.charAt(0).toUpperCase() + "</div>";
                html += "<div class='col-name'>" + app.name + "</div>";
                html += "<div class='col-ver'>" + app.cur + "</div>";
                html += "<div class='col-ver'>" + app.newv + "</div>";
                html += "<div class='col-action' id='action_" + j + "'><button class='btn-update' onclick='startSingleUpdate(" + j + ")'>Update</button></div></div>";
                container.innerHTML += html;
            }
        }

        function startSingleUpdate(index) {
            if (!checkInternet()) { showDialog('noInternetModal'); return; }
            var app = appList[index];
            var actionDiv = document.getElementById('action_' + index);
            
            actionDiv.innerHTML = "<div class='btn-progress'>Updating...</div><button class='btn-cancel' onclick='killWinget()'>X</button>";
            activeUpdates++;
            
            setTimeout(function() {
                var tmpErr = shell.ExpandEnvironmentStrings("%TEMP%") + "\\winget_err_" + index + ".txt";
                var cmd = 'cmd.exe /c winget upgrade --id "' + app.id + '" --silent --accept-package-agreements --accept-source-agreements > "' + tmpErr + '" 2>&1';
                var exitCode = shell.Run(cmd, 0, true);
                
                if (exitCode === 0) {
                    actionDiv.innerHTML = "<div class='btn-updated'>Updated</div>";
                } else if (exitCode === -1978335189 || exitCode === 1) {
                    actionDiv.innerHTML = "<div class='btn-prompt'>Expect a prompt</div>";
                    setTimeout(function() { checkErrorLog(index, tmpErr); }, 1000);
                } else {
                    showErrorState(index, tmpErr);
                }
                
                activeUpdates--;
                checkGlobalDone();
            }, 100);
        }

        function killWinget() {
            shell.Run("cmd.exe /c taskkill /F /IM winget.exe", 0, true);
        }
        
        function checkErrorLog(index, errFile) {
             showErrorState(index, errFile);
        }

        function showErrorState(index, errFile) {
            var actionDiv = document.getElementById('action_' + index);
            actionDiv.innerHTML = "<span class='text-error' onclick='showErrorModal(" + index + ", \"" + errFile.replace(/\\/g, "\\\\") + "\")'>ERROR</span>";
        }

        function resetToUpdate(index) {
            closeDialog('errorModal');
            var actionDiv = document.getElementById('action_' + index);
            actionDiv.innerHTML = "<button class='btn-update' onclick='startSingleUpdate(" + index + ")'>Update</button>";
        }

        function openUpdateAllModal() {
            var listDiv = document.getElementById('updateAllList');
            listDiv.innerHTML = "";
            for (var i = 0; i < appList.length; i++) {
                listDiv.innerHTML += "<div style='text-align:left; margin-bottom:8px; font-size:20px;'><label><input type='checkbox' id='chk_" + i + "' checked style='width:20px; height:20px;'> " + appList[i].name + "</label></div>";
            }
            showDialog('updateAllModal');
        }

        function executeUpdateAll() {
            closeDialog('updateAllModal');
            updateStartTime = new Date();
            
            for (var i = 0; i < appList.length; i++) {
                if (document.getElementById('chk_' + i).checked) {
                    startSingleUpdate(i);
                }
            }
        }

        function checkGlobalDone() {
            if (activeUpdates === 0 && updateStartTime !== null) {
                var diffStr = Math.round((new Date() - updateStartTime)/1000) + " seconds";
                document.getElementById('doneTotal').innerText = "All Selected";
                document.getElementById('doneTime').innerText = diffStr;
                showDialog('allDoneModal');
                updateStartTime = null;
                if(document.getElementById('chkShutdown').checked) shell.Run("shutdown /s /t 60", 0, false);
            }
        }

        function showDialog(id) { 
            document.getElementById(id).className = "overlay show";
        }
        function closeDialog(id) { 
            document.getElementById(id).className = "overlay";
        }

        function showErrorModal(index, logFile) {
            document.getElementById('errorAppName').innerText = appList[index].name;
            var errText = "Unknown error occurred or user cancelled prompt.";
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            if (logFile && fso.FileExists(logFile)) {
                var file = fso.OpenTextFile(logFile, 1);
                if(!file.AtEndOfStream) { errText = file.ReadAll(); }
                file.Close();
            }
            document.getElementById('errorCmdText').innerText = errText;
            
            var retryBtnContainer = document.getElementById('errorRetryContainer');
            retryBtnContainer.innerHTML = "<button onclick='resetToUpdate(" + index + ")' style='margin-top:15px; padding:12px 25px; background:#00a2ed; color:white; font-weight:bold; border:2px solid #0056b3; cursor:pointer; font-size:18px; border-radius:8px;'>Close & Retry</button>";
            showDialog('errorModal');
        }

        function toggleMenu() {
            var menu = document.getElementById('sideMenu');
            menu.className = (menu.className === 'side-menu open') ? 'side-menu' : 'side-menu open';
        }

        function toggleTheme() {
            document.body.className = document.body.className === 'dark-mode' ? '' : 'dark-mode';
        }

        function renderBanList() {
            var html = "";
            for (var i = 0; i < allApps.length; i++) {
                var isChecked = "";
                for (var b = 0; b < bannedApps.length; b++) {
                    if (allApps[i].id === bannedApps[b]) isChecked = "checked";
                }
                html += "<div style='margin-bottom:8px;'><label><input type='checkbox' id='ban_" + i + "' " + isChecked + " style='width:20px;height:20px;'> " + allApps[i].name + "</label></div>";
            }
            document.getElementById('banListContainer').innerHTML = html;
        }

        function applyBans() {
            bannedApps = [];
            for (var i = 0; i < allApps.length; i++) {
                if (document.getElementById('ban_' + i).checked) {
                    bannedApps.push(allApps[i].id);
                }
            }
            renderApps();
        }
        
        function refreshAppList() {
            toggleMenu();
            loadUpdates();
        }
    </script>
</head>
<body class="dark-mode" onload="initApp()">

    <div class="header">
        <div class="menu-btn" onclick="toggleMenu()">&#9776;</div>
        <div class="title">Winget GUI</div>
        <button class="btn-update-all" onclick="openUpdateAllModal()">Update All</button>
    </div>

    <div id="sideMenu" class="side-menu">
        <div class="menu-close" onclick="toggleMenu()">X</div>
        <h2 style="margin-top:0;">Settings</h2>
        
        <button class="btn-refresh" onclick="refreshAppList()">Refresh App List</button>

        <div class="menu-item">
            <span>Dark Mode</span>
            <label class="toggle-switch">
                <input type="checkbox" id="themeToggle" onclick="toggleTheme()" checked>
                <span class="slider"></span>
            </label>
        </div>
        <div class="menu-item">
            <span>Auto shutdown after Update All</span>
            <label class="toggle-switch">
                <input type="checkbox" id="chkShutdown">
                <span class="slider"></span>
            </label>
        </div>
        <div style="margin-top: 30px;">
            <p style="margin-bottom:10px; font-weight:bold; font-size:20px;">Ban Apps (Hide from updates):</p>
            <div id="banListContainer" style="background:#eee; color:#000; max-height:300px; overflow-y:auto; padding:15px; border:2px solid #ccc; border-radius:5px; font-size:18px;"></div>
            <button onclick="applyBans()" style="width:100%; margin-top:15px; padding:12px; background:#3b5998; color:white; border:none; cursor:pointer; font-weight:bold; font-size:18px; border-radius:8px;">Apply Bans</button>
        </div>
    </div>

    <div id="loadingText">Scanning for updates... Please wait.</div>
    <div class="container" id="appContainer"></div>

    <div id="noInternetModal" class="overlay">
        <div class="dialog">
            <div class="dialog-close" onclick="closeDialog('noInternetModal')">X</div>
            <div class="dialog-body">
                <div style="background:red; color:black; border-radius:50%; width:80px; height:80px; display:inline-block; line-height:80px; font-size:50px; font-weight:bold; border:4px solid black; margin-bottom:20px;">!</div>
                <h2 style="font-size:32px; margin:0;">No internet</h2>
            </div>
        </div>
    </div>

    <div id="errorModal" class="overlay">
        <div class="dialog">
            <div class="dialog-header">
                ERROR
                <div class="dialog-close" onclick="closeDialog('errorModal')">X</div>
            </div>
            <div class="dialog-body">
                <div style="color:red; font-weight:bold; font-size:22px;">Problem updating: <span id="errorAppName"></span></div>
                <div class="error-text" id="errorCmdText"></div>
                <div id="errorRetryContainer"></div>
            </div>
        </div>
    </div>

    <div id="updateAllModal" class="overlay">
        <div class="dialog" style="width:700px;">
            <div class="dialog-header">
                Update all
                <div class="dialog-close" onclick="closeDialog('updateAllModal')">X</div>
            </div>
            <div style="background:#f4f4f4; color:#3b5998; font-weight:bold; text-align:center; padding:10px; font-size:22px;">Select Apps to Update</div>
            <div class="dialog-body" style="background:#ccc; margin:15px; height:300px; overflow-y:auto; color:black; border: 2px inset #999;" id="updateAllList"></div>
            <button onclick="executeUpdateAll()" style="margin:15px; padding:15px; background:#28a745; color:white; font-weight:bold; border:3px solid #1e7e34; cursor:pointer; font-size:22px; border-radius:10px;">Start Selected Updates</button>
        </div>
    </div>

    <div id="allDoneModal" class="overlay">
        <div class="dialog">
            <div class="dialog-header">
                All updates done
                <div class="dialog-close" onclick="closeDialog('allDoneModal')">X</div>
            </div>
            <div class="dialog-body" style="text-align:left; font-size:24px; font-weight:bold; padding:40px;">
                <p>Total apps updated: <span id="doneTotal" style="color:#00a2ed;">0</span></p>
                <p>Time taken: <span id="doneTime" style="color:#00a2ed;">0 seconds</span></p>
            </div>
        </div>
    </div>

</body>
</html>